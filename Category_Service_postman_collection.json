{
  "info": {
    "name": "Category Service - Postman Collection",
    "description": "API endpoints for the Category Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "category_service_url",
      "value": "http://localhost:8003",
      "type": "string"
    },
    {
      "key": "salonId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "categoryId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Get Categories by Salon",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{category_service_url}}/api/categories/salon/{{salonId}}",
          "host": [
            "{{category_service_url}}"
          ],
          "path": [
            "api",
            "categories",
            "salon",
            "{{salonId}}"
          ]
        },
        "description": "Get all categories for a specific salon"
      },
      "response": []
    },
    {
      "name": "Get Category by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{category_service_url}}/api/categories/{{categoryId}}",
          "host": [
            "{{category_service_url}}"
          ],
          "path": [
            "api",
            "categories",
            "{{categoryId}}"
          ]
        },
        "description": "Get a specific category by its ID"
      },
      "response": []
    }
  ]
}

